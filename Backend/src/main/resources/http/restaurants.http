@url = http://localhost:6969

### Get all active restaurants (US-01)
# The list the restaurant overview page shows. Returns 204 when there are no restaurants.
GET {{url}}/api/restaurants

> {%
    const restaurants = response.body.data.data;
    if (restaurants && restaurants.length > 0) {
        client.global.set("restaurantId", restaurants[0].id);
    }
%}

### Get one restaurant by id
# Uses the id of the first restaurant from the request above. Run that one first.
GET {{url}}/api/restaurant/{{restaurantId}}

### Get the menu of a restaurant
GET {{url}}/api/restaurant/menu/{{restaurantId}}

### Log in as the template owner from Populator
POST {{url}}/api/users/auth/login
Content-Type: application/json

{
  "email": "owner@mtogo.dk",
  "password": "Password123!"
}

> {% client.global.set("token", response.body.token); %}

### Create a restaurant (requires the login above)
POST {{url}}/api/restaurants
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Test Pizzeria",
  "description": "Created from restaurants.http",
  "phoneNumber": "44444444",
  "street": "Testvej 1",
  "postalCode": "2200",
  "city": "København N"
}
